{
  "expo": {
    "name": "IRONVANT",
    "slug": "ironvant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ironvant",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.ironvant.ios",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090D1C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-audio",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ru"
            ]
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "IRONVANT shows your steps. The data stays on your iPhone."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "IRONVANT scans product barcodes. No pictures are saved.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "locales": {
      "en": "./locales/en.json",
      "ru": "./locales/ru.json"
    }
  }
}
